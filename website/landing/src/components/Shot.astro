---
// A responsive screenshot: webp at a few widths, width/height set so the page
// does not shift while it loads. `dark` swaps in another image under
// prefers-color-scheme: dark. All screenshots come from the demo (docs/screenshots).
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  dark?: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  eager?: boolean;
  class?: string;
}
const { src, dark, alt, widths, sizes, eager = false, class: cls } = Astro.props;

// Never ask for more pixels than the file has.
async function variants(img: ImageMetadata) {
  const ws = widths.filter((w) => w <= img.width);
  const made = await Promise.all(
    (ws.length ? ws : [img.width]).map((width) => getImage({ src: img, width, format: "webp", quality: 82 })),
  );
  return {
    srcset: made.map((m, i) => `${m.src} ${(ws.length ? ws : [img.width])[i]}w`).join(", "),
    fallback: made[made.length - 1],
  };
}
const light = await variants(src);
const night = dark ? await variants(dark) : null;
---
<picture>
  {night && <source media="(prefers-color-scheme: dark)" srcset={night.srcset} sizes={sizes} type="image/webp" />}
  <source srcset={light.srcset} sizes={sizes} type="image/webp" />
  <img
    class={cls}
    src={light.fallback.src}
    width={src.width}
    height={src.height}
    alt={alt}
    sizes={sizes}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    fetchpriority={eager ? "high" : undefined}
  />
</picture>
