---
// Breadcrumb (Docs > group > page) above the large page title.
import Icon from "./Icon.astro";
import { BASE } from "../../site.config.mjs";

const { entry, sidebar } = Astro.locals.starlightRoute;
const group = sidebar.find(
  (e) => e.type === "group" && e.entries.some((x) => x.type === "link" && x.isCurrent),
);
const title = entry.data.title;
---
{group && (
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href={`${BASE}/`}>Docs</a>
    <Icon name="chevron-right" size={13} />
    <span>{group.label}</span>
    <Icon name="chevron-right" size={13} />
    <span aria-current="page">{title}</span>
  </nav>
)}
{/* "_top" is Starlight's PAGE_TITLE_ID (its table of contents links to it). */}
<h1 id="_top">{title}</h1>
<style>
  .crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; font-size: 0.82rem; color: var(--ir-muted); }
  .crumbs a { color: inherit; text-decoration: none; }
  .crumbs a:hover { color: var(--ir-accent); text-decoration: underline; }
  h1 {
    margin-top: 0.5rem; color: var(--sl-color-white); font-size: clamp(2rem, 5vw, 2.5rem);
    font-weight: 800; letter-spacing: -0.03em; line-height: 1.1;
  }
</style>
