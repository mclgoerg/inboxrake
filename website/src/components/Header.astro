---
// The docs header like the landing page: logo + version, a rounded search
// field, then Home, GitHub, the theme switch and "Try the demo" (the demo
// button only exists when the demo is live - same build switch as the
// landing page). On phones only the title and the search icon remain here;
// the menu button is Starlight's and the rest lives in the menu.
import config from "virtual:starlight/user-config";
import Search from "virtual:starlight/components/Search";
import SiteTitle from "virtual:starlight/components/SiteTitle";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";
import Icon from "./Icon.astro";
import { DEMO_LIVE, GITHUB } from "../../landing/site.mjs";

const shouldRenderSearch =
  config.pagefind || config.components.Search !== "@astrojs/starlight/components/Search.astro";
---
<div class="header">
  <div class="title-wrapper"><SiteTitle /></div>
  <div class="search">{shouldRenderSearch && <Search />}</div>
  <div class="right-group print:hidden">
    <a class="nav-link" href="/">Home</a>
    <a class="nav-link" href={GITHUB}><Icon name="github" size={17} />GitHub</a>
    <ThemeSelect />
    {DEMO_LIVE && <a class="try-demo" href="/demo/">Try the demo<Icon name="arrow-right" size={16} /></a>}
  </div>
</div>
<style>
  .header { display: flex; align-items: center; gap: 1rem; height: 100%; }
  .title-wrapper { min-width: 0; overflow: clip; padding: 0.25rem; margin: -0.25rem; }
  .search { display: flex; flex: 1; min-width: 0; justify-content: flex-end; }
  .right-group { display: none; align-items: center; gap: 0.25rem; }
  .nav-link {
    display: inline-flex; align-items: center; gap: 0.4rem; min-height: 2.75rem; padding: 0 0.65rem;
    border-radius: 10px; color: var(--sl-color-white); font-weight: 500; font-size: 0.92rem; text-decoration: none;
  }
  .nav-link:hover { color: var(--ir-accent); }
  .try-demo {
    display: inline-flex; align-items: center; gap: 0.45rem; min-height: 2.25rem; padding: 0 1rem; margin-left: 0.5rem;
    border-radius: 999rem; background: var(--ir-accent); color: var(--ir-on-accent);
    font-size: 0.92rem; font-weight: 650; text-decoration: none; white-space: nowrap;
  }
  .try-demo:hover { background: var(--ir-accenth); }
  @media (min-width: 50rem) {
    .header { gap: 1.25rem; }
    .search { justify-content: flex-start; flex: 1 1 auto; margin-left: 0.5rem; }
    .right-group { display: flex; }
  }
</style>
