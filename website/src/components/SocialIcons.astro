---
// Starlight's GitHub link, plus the "Try the demo" button (only when the
// demo is live - the same build switch as the landing page).
import Default from "@astrojs/starlight/components/SocialIcons.astro";
import { DEMO_LIVE } from "../../landing/site.mjs";
---
<Default {...Astro.props}><slot /></Default>
{DEMO_LIVE && <a class="try-demo" href="/demo/">Try the demo</a>}
<style>
  .try-demo {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 1rem;
    border-radius: 999rem;
    background: var(--sl-color-accent);
    color: var(--inboxrake-on-accent);
    font-size: var(--sl-text-sm);
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
  }
  .try-demo:hover { filter: brightness(1.08); }
</style>
