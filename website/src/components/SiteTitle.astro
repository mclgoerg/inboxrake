---
import SiteTitle from "@astrojs/starlight/components/SiteTitle.astro";
import { VERSION, RELEASE_URL } from "../../release.mjs";
---
<div class="brand">
  <SiteTitle />
  <a class="version" href={RELEASE_URL} aria-label={`Release ${VERSION}`}>v{VERSION}</a>
</div>
<style>
  .brand { display: flex; align-items: center; gap: 0.5rem; min-width: 0; }
  .brand :global(.site-title) {
    color: var(--sl-color-white);
    font-size: 1.15rem;
    font-weight: 750;
    letter-spacing: -0.01em;
    gap: 0.6rem;
  }
  .brand :global(.site-title img) { width: 30px; height: 30px; border-radius: 8px; }
  .version {
    color: var(--ir-muted);
    background: var(--ir-panel2);
    border-radius: 999px;
    padding: 0.1rem 0.55rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .version:hover { text-decoration: underline; }
  @media (max-width: 22rem) {
    .brand :global(.site-title) { font-size: 1rem; gap: 0.4rem; }
    .brand :global(.site-title img) { width: 26px; height: 26px; }
  }
</style>
